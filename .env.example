# Kretabazaar Deployment Environment Configuration Example

# Public App URL (e.g. https://kretabazaar.vercel.app)
NEXT_PUBLIC_APP_URL=https://kretabazaar.vercel.app

# Backend API Endpoint
NEXT_PUBLIC_API_URL=https://api.kretabazaar.com/v1

# Stripe Payment Gateway Public Key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_kretabazaar_stripe_key_example
